# Copy to .env.local and fill in from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app
#
# These values are NOT secret. They identify the project; they authorise
# nothing. Every Firebase web app ships them in its JavaScript bundle. What
# protects the data is firestore.rules plus the role in the signed-in user's
# token. Do not spend effort hiding them.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The domain usernames are turned into email addresses under, internally.
# It receives no mail and nobody needs to own it. Keep it the same across
# every environment of one outlet, or existing logins stop resolving.
VITE_STAFF_EMAIL_DOMAIN=staff.swaada.local

# development | staging | production. Shown in the UI and sent to Sentry.
VITE_APP_ENV=development

# Leave empty in development so local noise stays out of the dashboard.
VITE_SENTRY_DSN=

# Point the SDKs at the local emulator suite instead of the real project.
VITE_USE_EMULATORS=false
