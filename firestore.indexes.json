{
  "indexes": [
    {
      "//": "History and analytics: bills across a range of cafe days, newest first.",
      "collectionGroup": "bills",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "businessDate", "order": "DESCENDING" },
        { "fieldPath": "__name__", "order": "DESCENDING" }
      ]
    },
    {
      "//": "A guest's own bills, newest first, on their account page.",
      "collectionGroup": "bills",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "customerId", "order": "ASCENDING" },
        { "fieldPath": "settledAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Analytics: rounds across a range of cafe days.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "businessDate", "order": "DESCENDING" },
        { "fieldPath": "__name__", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Today's cancelled rounds, so the kitchen is told rather than left guessing.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "businessDate", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },
    {
      "//": "The activity log, a day at a time, newest first.",
      "collectionGroup": "auditLog",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "businessDate", "order": "DESCENDING" },
        { "fieldPath": "at", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
