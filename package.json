{
  "name": "swaada-cafe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "emulators": "firebase emulators:start",
    "deploy:dev": "npm run build && firebase deploy --only hosting,firestore -P dev",
    "deploy:prod": "npm run build && firebase deploy --only hosting,firestore -P prod",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "test": "vitest run tests/money.test.ts tests/businessDate.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project swaada-rules-test \"vitest run tests/rules.test.ts\"",
    "test:all": "npm run test && npm run test:rules",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/react": "^10.74.0",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.19.0",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.27.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
